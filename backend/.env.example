# Server
IP=0.0.0.0
PORT=3000
CORS_ORIGIN=*

# Auth
JWT_SECRET=change-this-to-a-random-secret

# Database
DB_PATH=data/db.sqlite

# SQLite performance tuning
DB_CACHE_SIZE=-20000           # 20,000 pages ≈ 80MB
DB_MMAP_SIZE=268435456         # 256MB
DB_SYNC=NORMAL                 # OFF | NORMAL | FULL
DB_TEMP_STORE=MEMORY           # DEFAULT | FILE | MEMORY
DB_WAL_CHECKPOINT=TRUNCATE     # PASSIVE | FULL | RESTART | TRUNCATE
